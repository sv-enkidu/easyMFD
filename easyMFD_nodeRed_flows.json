    {
        "id": "988e8d57153a2659",
        "type": "function",
        "z": "easymfd_tab",
        "name": "easyMFD ALERTING config store",
        "func": "// easyMFD alert config store\n// Reads/writes the array of configured Alert Profiles to persistent\n// (file-based) global context, keyed as \"easyMFD_alerts\".\n//\n// Mirrors nodeRed_display_config_store_node.json exactly, with one\n// deliberate difference: display configs dedupe on d.topic (the MQTT\n// destination), because a display *is* a topic. Alert profiles are\n// intentionally topic-independent -- the same profile can be sent to\n// any display -- so they dedupe on a.name (the profile's own unique\n// identifier) instead.\n//\n// Requires the same \"file\" context store enabled in settings.js that\n// the display config store already relies on:\n//\n//   contextStorage: {\n//       default: \"memory\",\n//       file: { module: \"localfilesystem\" }\n//   }\n\nconst STORE = \"file\";\nconst KEY = \"easyMFD_alerts\";\n\nlet alerts = global.get(KEY, STORE) || [];\n\nif (msg.topic === \"save\") {\n    const incoming = msg.payload;\n\n    if (!incoming || !incoming.name || !incoming.name.trim()) {\n        node.warn(\"easyMFD: alert profile save rejected -- name is required\");\n        return { topic: \"list\", payload: alerts };\n    }\n\n    const idx = alerts.findIndex(a => a.name === incoming.name);\n    if (idx >= 0) {\n        alerts[idx] = incoming; // update existing (matched by profile name)\n    } else {\n        alerts.push(incoming); // new profile\n    }\n    global.set(KEY, alerts, STORE);\n} else if (msg.topic === \"delete\") {\n    alerts = alerts.filter(a => a.name !== msg.payload.name);\n    global.set(KEY, alerts, STORE);\n}\n// \"load\" (or any other topic) falls through here and just returns\n// the current list -- used on dashboard page load.\n\nreturn { topic: \"list\", payload: alerts };\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 500,
        "wires": [
            [
                "e11c1c1acd4dd51f"
            ]
        ]
    },
    {
        "id": "c2f001bd76af37af",
        "type": "function",
        "z": "easymfd_tab",
        "name": "easyMFD Alert Sender Function",
        "func": "// easyMFD Alert Sender\n// -----------------------------------------------------------------\n// This is the ONE shared node that every custom alert-trigger flow\n// wires into. Your own logic (heel angle threshold, pressure+temp\n// compound condition, anchor watch, whatever) lives entirely upstream\n// of this node, built with ordinary Node-RED nodes -- this node's\n// only job is: given a destination + a profile name, look up that\n// profile and emit the buzzer JSON.\n//\n// Input:\n//   msg.topic   = destination display's MQTT topic, e.g. \"nav_table\"\n//                 (the same topic string used for that display's\n//                 regular data topic -- NOT already suffixed with\n//                 \"/buzzer\", this function adds that).\n//   msg.payload = the Alert Profile name to fire, e.g. \"Critical Alert\"\n//                 (must match a profile saved via the Alert Manager UI).\n//\n// Output:\n//   msg.topic   = \"<destination>/buzzer\"\n//   msg.payload = JSON string, ready for an MQTT-out node, e.g.:\n//                 { \"loudness\": 100, \"frequency_hz\": 3000,\n//                   \"duration_ms\": 90000, \"segment_ms\": 5000,\n//                   \"pause_ms\": 1000 }\n//\n// Note the unit conversion: profiles are stored/edited in seconds\n// (human-friendly, matches the UI), but the wire format to the ESP32\n// uses milliseconds for firmware timing precision -- same \"SI/wire\n// units differ from human-facing UI units\" pattern already used\n// elsewhere in easyMFD (e.g. SignalK Kelvin -> displayed Fahrenheit).\n\nconst STORE = \"file\";\nconst KEY = \"easyMFD_alerts\";\n\nconst alerts = global.get(KEY, STORE) || [];\nconst destinationTopic = msg.topic;\nconst profileName = msg.payload;\n\nif (!destinationTopic || typeof destinationTopic !== \"string\") {\n    node.warn(\"easyMFD: Alert Sender got no destination topic on msg.topic -- alert dropped\");\n    return null;\n}\n\nconst profile = alerts.find(a => a.name === profileName);\n\nif (!profile) {\n    node.warn(`easyMFD: no alert profile named \"${profileName}\" found -- alert dropped`);\n    return null;\n}\n\nmsg.topic = `${destinationTopic}/buzzer`;\nmsg.payload = JSON.stringify({\n    loudness: profile.loudness,\n    frequency_hz: profile.frequency_hz,\n    duration_ms: Math.round(profile.duration_s * 1000),\n    segment_ms: Math.round(profile.segment_s * 1000),\n    pause_ms: Math.round(profile.pause_s * 1000)\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
