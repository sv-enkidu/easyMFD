    {
        "id": "easymfd_configstore",
        "type": "function",
        "z": "easymfd_tab",
        "name": "easyMFD config store",
        "func": "// easyMFD config store\n// Reads/writes the array of configured displays to persistent\n// (file-based) global context, keyed as \"easyMFD_displays\".\n//\n// IMPORTANT: this requires a \"file\" context store enabled in your\n// Node-RED settings.js, e.g.:\n//\n//   contextStorage: {\n//       default: \"memory\",\n//       file: { module: \"localfilesystem\" }\n//   }\n//\n// Without this, change STORE below to \"memory\" -- configs will work,\n// but will NOT survive a Node-RED restart.\n\nconst STORE = \"file\";\nconst KEY = \"easyMFD_displays\";\n\nlet displays = global.get(KEY, STORE) || [];\n\nif (msg.topic === \"save\") {\n    const incoming = msg.payload;\n    const idx = displays.findIndex(d => d.topic === incoming.topic);\n    if (idx >= 0) {\n        displays[idx] = incoming; // update existing (matched by MQTT topic)\n    } else {\n        displays.push(incoming); // new display\n    }\n    global.set(KEY, displays, STORE);\n} else if (msg.topic === \"delete\") {\n    displays = displays.filter(d => d.topic !== msg.payload.topic);\n    global.set(KEY, displays, STORE);\n}\n// \"load\" (or any other topic) falls through here and just returns\n// the current list -- used on dashboard page load.\n\nreturn { topic: \"list\", payload: displays };",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 180,
        "wires": [
            [
                "easymfd_template"
            ]
        ]
    },
