    {
        "id": "e11c1c1acd4dd51f",
        "type": "ui-template",
        "z": "easymfd_tab",
        "group": "easymfd_group",
        "page": "",
        "ui": "",
        "name": "easyMFD Display Manager (alerting)",
        "order": 2,
        "width": "0",
        "height": "0",
        "format": "<template>\n  <div style=\"padding:8px;\">\n    <div style=\"margin-bottom:1.5rem;\">\n      <p style=\"font-size:13px;color:var(--text-secondary);margin:0 0 8px;\">Configured alerts</p>\n      <div v-for=\"(a,i) in alerts\" :key=\"a.name\" style=\"display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:0.5px solid var(--border);border-radius:6px;margin-bottom:6px;\">\n        <div>\n          <span style=\"font-size:14px;font-weight:500;\">{{ a.name }}</span>\n          <span style=\"font-size:13px;color:var(--text-secondary);margin-left:10px;\">{{ summarize(a) }}</span>\n        </div>\n        <div style=\"display:flex;gap:6px;\">\n          <button @click=\"editAlert(i)\">Edit</button>\n          <button @click=\"deleteAlert(i)\">Delete</button>\n        </div>\n      </div>\n      <p v-if=\"alerts.length === 0\" style=\"font-size:13px;color:var(--text-muted);\">No alert profiles configured yet.</p>\n    </div>\n\n    <div style=\"background:var(--surface-2);border-radius:12px;border:0.5px solid var(--border);padding:1rem 1.25rem;\">\n      <p style=\"font-weight:500;font-size:15px;margin:0 0 12px;\">{{ editingIndex === null ? 'Add alert profile' : 'Edit alert profile' }}</p>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Alert Profile Name</label>\n          <input type=\"text\" v-model=\"form.name\" placeholder=\"Critical Alert\" style=\"width:100%;\" :disabled=\"editingIndex !== null\" />\n        </div>\n      </div>\n\n      <div style=\"border-top:0.5px solid var(--border);margin:4px 0 12px;\"></div>\n\n      <p style=\"font-size:13px;color:var(--text-secondary);margin:0 0 8px;\">This is the sound only -- it says nothing about when or where it fires. Wire the trigger logic (thresholds, timers, whatever) and the destination display separately, upstream of the Alert Sender node.</p>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Loudness ({{ form.loudness }}%)</label>\n          <input type=\"range\" v-model.number=\"form.loudness\" min=\"0\" max=\"100\" step=\"1\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Frequency ({{ frequencyHz }} Hz)</label>\n          <input type=\"range\" v-model.number=\"form.freqSlider\" min=\"0\" max=\"1000\" step=\"1\" style=\"width:100%;\" />\n        </div>\n      </div>\n\n      <div style=\"border-top:0.5px solid var(--border);margin:4px 0 12px;\"></div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Duration of Alert (sec)</label>\n          <input type=\"number\" v-model.number=\"form.duration_s\" min=\"0.1\" step=\"0.1\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Duration of Tone Segment (sec)</label>\n          <input type=\"number\" v-model.number=\"form.segment_s\" min=\"0.1\" step=\"0.1\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Duration of Segment Pause (sec)</label>\n          <input type=\"number\" v-model.number=\"form.pause_s\" min=\"0\" step=\"0.1\" style=\"width:100%;\" />\n        </div>\n      </div>\n      <p style=\"font-size:12px;color:var(--text-muted);margin:-6px 0 12px;\">Example: Duration of Alert 90s, Segment 5s, Pause 1s &rarr; sounds 5s, silent 1s, repeats until 90s total, then stops (even mid-segment).</p>\n\n      <div style=\"display:flex;gap:8px;margin-top:4px;\">\n        <button @click=\"saveAlert\" style=\"background:var(--fill-primary);color:var(--on-primary);border:none;\">{{ editingIndex === null ? 'Save alert' : 'Update alert' }}</button>\n        <button @click=\"clearForm\">Clear form</button>\n      </div>\n      <p v-if=\"formError\" style=\"font-size:13px;color:var(--text-danger);margin:8px 0 0;\">{{ formError }}</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      alerts: [],\n      editingIndex: null,\n      formError: '',\n      form: this.blankForm()\n    }\n  },\n  computed: {\n    // Live Hz readout for the log-scale frequency slider. The slider\n    // itself stores a raw 0-1000 position (form.freqSlider); this is\n    // purely for display -- the actual Hz value is computed at save\n    // time via sliderToHz().\n    frequencyHz() {\n      return this.sliderToHz(this.form.freqSlider)\n    }\n  },\n  methods: {\n    blankForm() {\n      return {\n        name: '',\n        loudness: 100,\n        freqSlider: this.hzToSlider(2000), // ~2000Hz default starting point\n        duration_s: 5,\n        segment_s: 5,\n        pause_s: 0\n      }\n    },\n    // Log-scale mapping: slider 0-1000 <-> 100-15,000 Hz. Most of the\n    // slider's travel covers the low end, where pitch differences are\n    // actually easy to hear; rounded to the nearest 10Hz for a clean\n    // display value.\n    sliderToHz(v) {\n      const hz = 100 * Math.pow(150, v / 1000)\n      return Math.round(hz / 10) * 10\n    },\n    hzToSlider(hz) {\n      const safeHz = Math.max(100, Math.min(15000, hz || 2000))\n      return Math.round(1000 * Math.log(safeHz / 100) / Math.log(150))\n    },\n    summarize(a) {\n      return `${a.loudness}% \\u2022 ${a.frequency_hz}Hz \\u2022 ${a.duration_s}s total (${a.segment_s}s on / ${a.pause_s}s off)`\n    },\n    clearForm() {\n      this.form = this.blankForm()\n      this.editingIndex = null\n      this.formError = ''\n    },\n    editAlert(i) {\n      const a = this.alerts[i]\n      this.form = Object.assign(this.blankForm(), {\n        name: a.name,\n        loudness: a.loudness,\n        freqSlider: this.hzToSlider(a.frequency_hz),\n        duration_s: a.duration_s,\n        segment_s: a.segment_s,\n        pause_s: a.pause_s\n      })\n      this.editingIndex = i\n      this.formError = ''\n    },\n    deleteAlert(i) {\n      const a = this.alerts[i]\n      this.send({ topic: 'delete', payload: { name: a.name } })\n    },\n    saveAlert() {\n      if (!this.form.name || !this.form.name.trim()) {\n        this.formError = 'Give this alert profile a name first.'\n        return\n      }\n      if (!this.form.duration_s || this.form.duration_s <= 0) {\n        this.formError = 'Duration of Alert must be greater than 0.'\n        return\n      }\n      if (!this.form.segment_s || this.form.segment_s <= 0) {\n        this.formError = 'Duration of Tone Segment must be greater than 0.'\n        return\n      }\n      this.formError = ''\n\n      const payload = {\n        name: this.form.name.trim(),\n        loudness: this.form.loudness,\n        frequency_hz: this.sliderToHz(this.form.freqSlider),\n        duration_s: this.form.duration_s,\n        segment_s: this.form.segment_s,\n        pause_s: this.form.pause_s\n      }\n\n      this.send({ topic: 'save', payload })\n      this.clearForm()\n    }\n  },\n  mounted() {\n    this.send({ topic: 'load', payload: {} })\n  },\n  watch: {\n    msg: function(newVal) {\n      if (!newVal) return\n      if (newVal.topic === 'list') {\n        this.alerts = newVal.payload || []\n      }\n    }\n  }\n}\n</script>\n\n<style>\n  input[type=\"text\"],\n  input[type=\"number\"],\n  select {\n    background-color: #f2f2f2;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    padding: 6px 8px;\n    box-sizing: border-box;\n    color: #111;\n  }\n\n  input[type=\"range\"] {\n    accent-color: #0094CE;\n  }\n\n  input:focus,\n  select:focus {\n    outline: none;\n    border-color: #0094CE;\n    background-color: #ffffff;\n  }\n</style>\n",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
