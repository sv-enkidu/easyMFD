    {
        "id": "easymfd_template",
        "type": "ui-template",
        "z": "easymfd_tab",
        "group": "easymfd_group",
        "page": "",
        "ui": "",
        "name": "easyMFD display manager 1.0 (display only)",
        "order": 1,
        "width": "0",
        "height": "0",
        "format": "<template>\n  <div style=\"padding:8px;\">\n    <div style=\"margin-bottom:1.5rem;\">\n      <p style=\"font-size:13px;color:var(--text-secondary);margin:0 0 8px;\">Configured displays</p>\n      <div v-for=\"(d,i) in displays\" :key=\"d.topic\" style=\"display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:0.5px solid var(--border);border-radius:6px;margin-bottom:6px;\">\n        <div>\n          <span style=\"font-size:14px;font-weight:500;\">{{ d.name }}</span>\n          <span style=\"font-size:13px;color:var(--text-secondary);margin-left:10px;\">{{ d.path }} &rarr; {{ d.topic }}</span>\n        </div>\n        <div style=\"display:flex;gap:6px;\">\n          <button @click=\"editDisplay(i)\">Edit</button>\n          <button @click=\"deleteDisplay(i)\">Delete</button>\n        </div>\n      </div>\n      <p v-if=\"displays.length === 0\" style=\"font-size:13px;color:var(--text-muted);\">No displays configured yet.</p>\n    </div>\n\n    <div style=\"background:var(--surface-2);border-radius:12px;border:0.5px solid var(--border);padding:1rem 1.25rem;\">\n      <p style=\"font-weight:500;font-size:15px;margin:0 0 12px;\">{{ editingIndex === null ? 'Add display' : 'Edit display' }}</p>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Display Name</label>\n          <input type=\"text\" v-model=\"form.name\" placeholder=\"Helm - Outside temp\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">MQTT topic (destination display ID)</label>\n          <input type=\"text\" v-model=\"form.topic\" placeholder=\"boat/display/helm_1\" style=\"width:100%;\" :disabled=\"editingIndex !== null\" />\n        </div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">SignalK path</label>\n          <input type=\"text\" v-model=\"form.path\" placeholder=\"environment.outside.temperature\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">SignalK source (optional)</label>\n          <input type=\"text\" v-model=\"form.source\" placeholder=\"Leave blank to match any source\" style=\"width:100%;\" />\n        </div>\n      </div>\n\n      <div style=\"border-top:0.5px solid var(--border);margin:4px 0 12px;\"></div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Title Displayed</label>\n          <input type=\"text\" v-model=\"form.title\" placeholder=\"Outside temperature\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Unit Displayed</label>\n          <input type=\"text\" v-model=\"form.unit\" placeholder=\"F\" style=\"width:100%;\" />\n        </div>\n      </div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Math expression (x = raw SignalK value)</label>\n          <input type=\"text\" v-model=\"form.math\" placeholder=\"(x - 273.15) * 9/5 + 32\" style=\"width:100%;font-family:monospace;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Decimal places</label>\n          <input type=\"number\" v-model.number=\"form.decimals\" min=\"0\" max=\"6\" style=\"width:100%;\" />\n        </div>\n      </div>\n\n      <div style=\"border-top:0.5px solid var(--border);margin:4px 0 12px;\"></div>\n\n      <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:12px;\">\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Font color</label>\n          <select v-model=\"form.color\" style=\"width:100%;\">\n            <option>white</option><option>yellow</option><option>cyan</option><option>red</option><option>green</option><option>orange</option><option>magenta</option><option>blue</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Font size (1-6)</label>\n          <input type=\"number\" v-model.number=\"form.size\" min=\"1\" max=\"6\" style=\"width:100%;\" />\n        </div>\n        <div>\n          <label style=\"font-size:13px;color:var(--text-secondary);display:block;margin-bottom:4px;\">Brightness ({{ form.brightness }})</label>\n          <input type=\"range\" v-model.number=\"form.brightness\" min=\"0\" max=\"255\" step=\"1\" style=\"width:100%;\" />\n        </div>\n      </div>\n\n      <div style=\"display:flex;gap:8px;margin-top:4px;\">\n        <button @click=\"saveDisplay\" style=\"background:var(--fill-primary);color:var(--on-primary);border:none;\">{{ editingIndex === null ? 'Save display' : 'Update display' }}</button>\n        <button @click=\"clearForm\">Clear form</button>\n      </div>\n      <p v-if=\"formError\" style=\"font-size:13px;color:var(--text-danger);margin:8px 0 0;\">{{ formError }}</p>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      displays: [],\n      editingIndex: null,\n      formError: '',\n      form: this.blankForm()\n    }\n  },\n  methods: {\n    blankForm() {\n      return { name:'', topic:'', path:'', source:'', title:'', unit:'', math:'x', decimals:1, color:'white', size:4, brightness:255 }\n    },\n    clearForm() {\n      this.form = this.blankForm()\n      this.editingIndex = null\n      this.formError = ''\n    },\n    editDisplay(i) {\n      this.form = Object.assign({}, this.displays[i])\n      this.editingIndex = i\n      this.formError = ''\n    },\n    deleteDisplay(i) {\n      const d = this.displays[i]\n      this.send({ topic: 'delete', payload: { topic: d.topic } })\n    },\n    saveDisplay() {\n      if (!this.form.name || !this.form.topic || !this.form.path || !this.form.title || !this.form.unit) {\n        this.formError = 'Fill in display name, MQTT topic, SignalK path, title, and unit first.'\n        return\n      }\n      this.formError = ''\n      if (!this.form.math) this.form.math = 'x'\n      this.send({ topic: 'save', payload: Object.assign({}, this.form) })\n      this.clearForm()\n    }\n  },\n  mounted() {\n    this.send({ topic: 'load', payload: {} })\n  },\n  watch: {\n    msg: function(newVal) {\n      if (!newVal) return\n      if (newVal.topic === 'list') {\n        this.displays = newVal.payload || []\n      }\n    }\n  }\n}\n</script>\n\n<style>\n  input[type=\"text\"],\n  input[type=\"number\"],\n  select {\n    background-color: #f2f2f2;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    padding: 6px 8px;\n    box-sizing: border-box;\n    color: #111;\n  }\n\n  input[type=\"range\"] {\n    accent-color: #0094CE;\n  }\n\n  input:focus,\n  select:focus {\n    outline: none;\n    border-color: #0094CE;\n    background-color: #ffffff;\n  }\n</style>",
        "storeOutMessages": true,
