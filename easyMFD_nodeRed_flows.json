    {
        "id": "5b3b3d1f1d837b6d",
        "type": "function",
        "z": "easymfd_tab",
        "name": "Universal Function to Control Display PIpeline SK to MQTT OUT",
        "func": "// easyMFD universal display function\n// Reads display configs saved by the easyMFD dashboard (global context,\n// key \"easyMFD_displays\") and, for every incoming (flattened) SignalK\n// delta, checks whether any configured display wants that path/source.\n// For each match, evaluates that display's \"math\" expression against\n// the raw value, formats it, and emits one MQTT-ready message per\n// matching display.\n//\n// Input: from signalk-on-delta (Flatten checked). msg.topic = SK path,\n// msg.payload = raw (SI) value, msg[\"$source\"] = source identifier.\n//\n// Output: one msg per matching display config, msg.topic = that\n// display's MQTT topic, msg.payload = JSON string ready for mqtt-out.\n\nconst STORE = \"file\";\nconst KEY = \"easyMFD_displays\";\n\nconst displays = global.get(KEY, STORE) || [];\n\n// Find every configured display that wants this path (and, if it\n// specified a source, matches that source too).\nconst matches = displays.filter(d => {\n    if (d.path !== msg.topic) return false;\n    if (d.source && d.source !== msg[\"$source\"]) return false;\n    return true;\n});\n\nif (matches.length === 0) {\n    return null; // nothing configured for this path -- drop it\n}\n\nconst outputs = [];\n\nmatches.forEach(d => {\n    let result;\n    try {\n        const mathExpr = (d.math && d.math.trim()) ? d.math : \"x\";\n        result = new Function(\"x\", \"return \" + mathExpr)(msg.payload);\n    } catch (e) {\n        node.warn(`easyMFD: math expression failed for \"${d.name}\" (${d.topic}): ${e.message}`);\n        return; // skip this display, don't send bad data\n    }\n\n    if (typeof result !== \"number\" || Number.isNaN(result)) {\n        node.warn(`easyMFD: math expression for \"${d.name}\" (${d.topic}) did not return a number`);\n        return;\n    }\n\n    const decimals = (typeof d.decimals === \"number\") ? d.decimals : 1;\n\n    outputs.push({\n        topic: d.topic,\n        payload: JSON.stringify({\n            title: d.title,\n            value: result.toFixed(decimals),\n            unit: d.unit,\n            font_color: d.color,\n            brightness: d.brightness,\n            font_size: d.size\n        })\n    });\n});\n\nreturn [outputs];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 280,
        "wires": [
            [
                "eecd6f3874c435c6"
            ]
        ]
